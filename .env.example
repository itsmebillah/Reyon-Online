# REYON Business OS environment-variable contract
#
# Public Supabase connection metadata used by the official SSR Auth client.
# These values identify the project and cannot bypass Row Level Security.
# Obtain them from the linked Supabase project and configure every environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Add further variable names only when architecture defines their owner, purpose,
# exposure, source, environments, and rotation requirements.
# Never place real credentials, tokens, project passwords, or secret values in this file.
